{
  "manifest_version": 3,
  "name": "LLM Forensic Logger",
  "version": "1.27",
  "description": "Logs LLM/AI chat rounds to local filesystem as MD and JSON.",
  "permissions": [
    "downloads",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://claude.ai/*",
    "*://duck.ai/*",
    "*://gemini.google.com/*",
    "*://*.googleusercontent.com/*",
    "*://labs.google/fx/tools/flow*",
    "*://www.google.com/*",
    "*://*.google.com/*",
    "*://notebooklm.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/cfi.16.png",
    "32": "icons/cfi.32.png",
    "48": "icons/cfi.48.png",
    "128": "icons/cfi.128.png"
  },
  "action": {
    "default_title": "LLM Forensic Logger",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/cfi.16.png",
      "32": "icons/cfi.32.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://duck.ai/*",
        "*://gemini.google.com/*",
        "*://*.googleusercontent.com/*",
        "*://labs.google/fx/tools/flow*",
        "*://www.google.com/search*",
        "*://*.google.com/search*",
        "*://notebooklm.google.com/*"
      ],
      "js": [
        "modules/index.js",
        "modules/chatgpt.js",
        "modules/claude.js",
        "modules/duckai.js",
        "modules/gemini.js",
        "modules/google_flow.js",
        "modules/google-search-ai-logger.js",
        "modules/notebooklm.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
