{
  "manifest_version": 3,
  "name": "LLM Forensic Logger",
  "version": "1.2",
  "description": "Logs LLM/AI chat rounds to local filesystem as MD and JSON.",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://claude.ai/*",
    "*://gemini.google.com/*",
    "*://notebooklm.google.com/*",
    "*://duck.ai/*",
    "*://www.google.com/search*",
    "*://labs.google/fx/tools/flow*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LLM Forensic Logger"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://notebooklm.google.com/*",
        "*://duck.ai/*",
        "*://www.google.com/search*",
        "*://labs.google/fx/tools/flow*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
