=== manifest.json ===

``
{
  "manifest_version": 3,
  "name": "LLM Forensic Logger",
  "version": "1.26",
  "description": "Logs LLM/AI chat rounds to local filesystem as MD and JSON.",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://claude.ai/*",
    "*://duck.ai/*",
    "*://gemini.google.com/*",
    "*://*.googleusercontent.com/*",
    "*://labs.google/fx/tools/flow*",
    "*://www.google.com/*",
    "*://*.google.com/*",
    "*://notebooklm.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LLM Forensic Logger",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://duck.ai/*",
        "*://gemini.google.com/*",
        "*://*.googleusercontent.com/*",
        "*://labs.google/fx/tools/flow*",
        "*://www.google.com/search*",
        "*://*.google.com/search*",
        "*://notebooklm.google.com/*"
      ],
      "js": [
        "modules/index.js",
        "modules/chatgpt.js",
        "modules/claude.js",
        "modules/duckai.js",
        "modules/gemini.js",
        "modules/google_flow.js",
        "modules/google-search-ai-logger.js",
        "modules/notebooklm.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

