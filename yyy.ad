cat  >> "modules/google-search-ai-logger.js" << 'EOF_ARCHIVE_CHUNK'
// @match *://www.google.com/search*
// @match *://*.google.com/search*
// @host_permissions *://www.google.com/*
// @host_permissions *://*.google.com/*
// @run_at document_idle

/**
 * google-search-ai-logger.js
 */

(() => {
  'use strict';

  const MODULE_NAME = 'google-search-ai';
  const BUTTON_LABEL = 'Log Entire Session';
  const BUTTON_ID = 'forensic-log-session-btn';

  const SKIP_TAGS = new Set(['script', 'style', 'noscript', 'svg', 'path', 'img', 'br', 'hr', 'input', 'button']);

  // ─── Page Detection (content-based, not just URL) ───

  function shouldActivate() {
    // Method 1: URL parameter (fast, works for live AI Mode)
    const params = new URLSearchParams(window.location.search);
    if (params.get('udm') === '50' || params.get('udm') === '14') return 'url_param';

    // Method 2: Actual content on the page
    // (works for saved sessions that might have different URLs)
