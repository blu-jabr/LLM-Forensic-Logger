function setStatus(text, color) {
  const el = document.getElementById('status');
  if (el) { el.textContent = text; el.style.color = color || 'green'; }
}

function bindButton(id, fn) {
  const el = document.getElementById(id);
  if (!el) { console.error('[FL popup] Missing element #' + id + ' — popup.html/popup.js mismatch'); return; }
  el.addEventListener('click', fn);
}

const SUPPORTED = /chatgpt\.com|chat\.openai\.com|claude\.ai|duck\.ai|gemini\.google\.com|labs\.google|notebooklm\.google\.com|www\.google\.com\/search|chat.z.ai/

function sendBulk(tab) {
  chrome.tabs.sendMessage(tab.id, { type: 'BULK_LOG_REQUEST' }, (response) => {
    if (chrome.runtime.lastError) setStatus('Error: Please refresh the page!', 'red');
    else setStatus('Extracting... Check downloads.');
    setTimeout(() => window.close(), 3000);
  });
}

bindButton('bulkLog', () => {
  chrome.tabs.query({ active: true, currentWindow: true }, (tabs) => {
    const tab = tabs && tabs[0];
    if (tab && SUPPORTED.test(tab.url || '')) { sendBulk(tab); return; }
    // Active tab isn't a supported LLM page (e.g., you followed a citation link).
    // Find any supported tab instead.
    chrome.tabs.query({}, (all) => {
      const cand = all.find(t => SUPPORTED.test(t.url || ''));
      if (!cand) setStatus('No supported LLM tab found.', 'red');
      else sendBulk(cand);
    });
  });
});


bindButton('handoff', () => {
  const requestHandoff = (tab) => {
    let chatId = 'unknown';
    try { chatId = new URL(tab.url).pathname.split('/').pop() || 'unknown'; } catch (e) {}
    chrome.runtime.sendMessage({ type: 'GENERATE_HANDOFF', chatId }, (response) => {
      if (chrome.runtime.lastError || !response) {
        setStatus("Error: background unreachable. Reload the extension.", 'red');
      } else if (response.status === 'success') {
        setStatus(`Handoff written from ${response.rounds} rounds. Check downloads.`, 'green');
        setTimeout(() => window.close(), 4000);
      } else if (response.status === 'empty') {
        setStatus(response.message, '#b45309');
      } else {
        setStatus('Error: ' + (response.error || 'unknown'), 'red');
      }
    });
  };
  chrome.tabs.query({ active: true, currentWindow: true }, (tabs) => {
    const tab = tabs && tabs[0];
    if (tab && SUPPORTED.test(tab.url || '')) { requestHandoff(tab); return; }
    chrome.tabs.query({}, (all) => {
      const cands = all.filter(t => SUPPORTED.test(t.url || ''));
      // Prefer a Gemini chat tab — handoff needs a real chatId
      const cand = cands.find(t => /gemini\.google\.com\/app\//.test(t.url || '')) || cands[0];
      if (!cand) setStatus('No supported LLM tab found.', 'red');
      else requestHandoff(cand);
    });
  });
});


bindButton('debugLog', () => {
  chrome.runtime.sendMessage({ type: 'DOWNLOAD_DEBUG_LOG' }, (res) => {
    if (chrome.runtime.lastError) setStatus('Background unreachable.', 'red');
    else setStatus('Debug log written (' + (res && res.entries) + ' entries).');
    setTimeout(() => window.close(), 2000);
  });
});

console.log('[FL popup] ids present:',
  ['bulkLog', 'handoff', 'debugLog'].filter(id => !!document.getElementById(id)));
